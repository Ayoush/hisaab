{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSTR-1 B2B (GSTN)",
  "type": "object",
  "required": ["gstin", "fp", "b2b"],
  "additionalProperties": false,
  "properties": {
    "gstin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$" },
    "fp": { "type": "string", "pattern": "^(0[1-9]|1[0-2])[0-9]{4}$" },
    "b2b": {
      "type": "array",
      "items": { "$ref": "#/definitions/b2bEntry" }
    }
  },
  "definitions": {
    "b2bEntry": {
      "type": "object",
      "required": ["ctin", "inv"],
      "additionalProperties": false,
      "properties": {
        "ctin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$" },
        "inv": {
          "type": "array",
          "items": { "$ref": "#/definitions/invoice" }
        }
      }
    },
    "invoice": {
      "type": "object",
      "required": ["inum", "idt", "val", "pos", "rchrg", "inv_typ", "itms"],
      "additionalProperties": false,
      "properties": {
        "inum": { "type": "string" },
        "idt": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}-[0-9]{4}$" },
        "val": { "type": "number" },
        "pos": { "type": "string", "pattern": "^[0-9]{2}$" },
        "rchrg": { "type": "string", "enum": ["Y", "N"] },
        "inv_typ": { "type": "string", "enum": ["R"] },
        "itms": {
          "type": "array",
          "items": { "$ref": "#/definitions/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["num", "itm_det"],
      "additionalProperties": false,
      "properties": {
        "num": { "type": "number" },
        "itm_det": { "$ref": "#/definitions/itemDetail" }
      }
    },
    "itemDetail": {
      "type": "object",
      "required": ["rt", "txval", "iamt", "camt", "samt", "csamt"],
      "additionalProperties": false,
      "properties": {
        "rt": { "type": "number" },
        "txval": { "type": "number" },
        "iamt": { "type": "number" },
        "camt": { "type": "number" },
        "samt": { "type": "number" },
        "csamt": { "type": "number" }
      }
    }
  }
}
